# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/

# Large generated data files (regenerated by scripts/process_all.py)
public/data/plots_wgs84.geojson
public/data/search_index.json
public/data/allocated_lands_index.json
public/data/roads_named.geojson
public/data/villages/

# Generated by the offline enrichment pipeline (pipeline/*.mjs)
public/data/plots.clean.geojson
public/data/plots.enriched.geojson
public/data/*.pmtiles
public/data/search.json

# Authoritative APCRDA scrape (regenerable via scripts/scrape_apcrda.mjs).
# The big raw layers are ignored; only the small inputs our pipelines read are kept.
public/data/sources/apcrda/*
!public/data/sources/apcrda/manifest.json
!public/data/sources/apcrda/trunk_roads.geojson
!public/data/sources/apcrda/land_allotments.geojson
!public/data/sources/apcrda/available_lands.geojson

# In-app review comments (dev comment tool → vite /__feedback)
feedback/

